# Copy to .env and fill in. Never commit real keys.
PORT=8787

# xAI (server-side only; the app gets short-lived client secrets)
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
# Check the current model list in the xAI console before pinning.
XAI_VISION_MODEL=grok-4.20-0309-non-reasoning
XAI_TASK_MODEL=grok-4.20-reasoning

# Database: Supabase -> Project Settings -> Database -> Connection string -> "Transaction pooler" (port 6543).
# Unset = in-memory store (fine for local testing, data is lost on restart).
DATABASE_URL=

# Shared secret for scheduled jobs (/v1/jobs/missed-doses, /v1/jobs/price-watches). Vercel sends CRON_SECRET to its crons.
CRON_SECRET=

# Auth: verify Supabase session JWTs. Use one of these:
SUPABASE_JWT_SECRET=
SUPABASE_JWKS_URL=
# Local development only: accept "dev:<userId>" bearer tokens.
DEV_AUTH=0

# Optional integrations
INSTACART_API_KEY=
INSTACART_BASE_URL=https://connect.dev.instacart.tools
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=
